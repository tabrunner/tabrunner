{
  "name": "tabrunner",
  "description": "Provider-agnostic browser agent extension",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "workspaces": [
    "daemon"
  ],
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "release": "bun run scripts/release.ts",
    "bridge": "bun daemon/src/index.ts",
    "bridge:check": "bun daemon/smoke.ts",
    "bridge:bundle": "bun run scripts/build-daemon.ts",
    "compile": "tsc --noEmit && tsc --noEmit -p daemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deadcode": "knip",
    "i18n:check": "bun run scripts/check-i18n.ts",
    "deadcode:fix": "knip --fix --allow-remove-files",
    "icons": "bun run scripts/gen-icons.ts",
    "shots": "bun run scripts/shoot-store.ts",
    "shots:ui": "bun run scripts/shoot-ui.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@shadcn/react": "^0.3.0",
    "i18next": "^26.3.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "knip": "^6",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  },
  "patchedDependencies": {
    "@shadcn/react@0.3.0": "patches/@shadcn%2Freact@0.3.0.patch"
  }
}
