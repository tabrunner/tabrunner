{
  "name": "tabrunner-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui-components/react": "^1.0.0-rc.0",
      "@eslint/js": "^10.0.1",
      "@fontsource-variable/figtree": "^5.2.5",
      "@fontsource-variable/jetbrains-mono": "^5.2.5",
      "@fontsource-variable/unbounded": "^5.2.5",
      "@gusnips/vite": "^0.8.44",
      "@modelcontextprotocol/sdk": "^1.22.0",
      "@providerkit/core": "0.26.2",
      "@resvg/resvg-js": "^2.6.2",
      "@shadcn/react": "^0.3.0",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.3.0",
      "@types/chrome": "^0.2.5",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.0.0",
      "@wxt-dev/module-react": "^1.1.5",
      "eslint": "^10.8.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "globals": "^17.9.0",
      "i18next": "^26.3.6",
      "jsdom": "^30.0.1",
      "knip": "^6",
      "prettier": "^3.9.6",
      "puppeteer-core": "^25.5.0",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "react-i18next": "^17.0.11",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1",
      "tailwindcss": "^4.3.3",
      "turbo": "^2.11.4",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.66.0",
      "vite": "^7.1.0",
      "vitest": "^4.1.10",
      "wxt": "^0.21.3",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "turbo lint",
    "lint:tooling": "eslint scripts",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location .cache/prettier-cache",
    "deadcode": "knip --workspace apps/extension --workspace packages/mcp",
    "deadcode:fix": "bun run deadcode --fix --allow-remove-files",
    "i18n:check": "bun run --cwd apps/extension i18n:check",
    "check": "turbo run lint typecheck build && bun run format:check && bun run deadcode && bun run i18n:check",
    "check:workspace": "bun scripts/check-workspace.ts",
    "extension": "bun run --cwd apps/extension dev",
    "site": "bun run --cwd apps/site dev",
    "zip": "bun run --cwd apps/extension zip",
    "release": "bun run scripts/release.ts",
    "bridge": "bun packages/mcp/src/index.ts",
    "bridge:check": "bun packages/mcp/smoke.ts",
    "bridge:bundle": "bun run scripts/build-daemon.ts",
    "icons": "bun run --cwd apps/extension icons",
    "shots": "bun run --cwd apps/extension shots",
    "shots:ui": "bun run --cwd apps/extension shots:ui"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "patchedDependencies": {
    "@shadcn/react@0.3.0": "patches/@shadcn%2Freact@0.3.0.patch"
  }
}
