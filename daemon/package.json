{
  "name": "tabrunner-mcp",
  "description": "MCP server that lets Claude, ChatGPT or any MCP client drive the TabRunner browser agent in your own Chrome",
  "version": "0.15.0",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé <gustavonips@gmail.com>",
  "homepage": "https://tabrunner.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabrunner/tabrunner.git",
    "directory": "daemon"
  },
  "bugs": "https://github.com/tabrunner/tabrunner/issues",
  "keywords": [
    "mcp",
    "browser",
    "chrome",
    "agent",
    "tabrunner"
  ],
  "mcpName": "app.tabrunner/tabrunner",
  "bin": {
    "tabrunner-mcp": "dist/tabrunner-mcp.js"
  },
  "files": [
    "dist/tabrunner-mcp.js"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "compile": "tsc --noEmit",
    "prepack": "bun build --target=bun src/index.ts --outfile dist/tabrunner-mcp.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
